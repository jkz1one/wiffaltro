; Engine configuration file.
; Wiffaltro Phase 0 foundation.
config_version=5

[application]

config/name="Wiffaltro"
run/main_scene="res://src/labs/pitch_bat_lab/pitch_bat_lab.tscn"

[autoload]

ContentDB="*res://src/content/content_db.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Ball"
3d_physics/layer_3="Players"
3d_physics/layer_4="RuleVolumes"
3d_physics/layer_5="Debug"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
