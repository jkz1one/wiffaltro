[ext_resource type="Resource" path="res://src/content/pitches/sidearm_sinker.tres" id="4_side_sinker"]
[ext_resource type="Resource" path="res://src/content/pitches/overhand_slider.tres" id="5_over_slider"]
[ext_resource type="Resource" path="res://src/content/pitches/sidearm_slider.tres" id="6_side_slider"]
[ext_resource type="Resource" path="res://src/content/pitches/eephus.tres" id="7_eephus"]
