[ext_resource type="Resource" path="res://src/content/swings/power_swing.tres" id="17_power_swing"]

[resource]
script = ExtResource("1_manifest")
pitches = [
	ExtResource("2_four_seam"),
	ExtResource("3_over_sinker"),
	ExtResource("4_side_sinker"),
	ExtResource("5_over_slider"),
	ExtResource("6_side_slider"),
	ExtResource("7_eephus"),
	ExtResource("8_knuckle"),
	ExtResource("9_riser"),
	ExtResource("10_drop")
]
players = [ExtResource("11_player")]
deliveries = [ExtResource("12_overhand"), ExtResource("13_sidearm")]
ball_aero_profiles = [ExtResource("14_aero")]
ball_setups = [ExtResource("15_setup")]
swing_profiles = [ExtResource("16_contact_swing"), ExtResource("17_power_swing")]
